{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OrgLogosBucketAccess",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::saasboard-org-logos/*"
    },
    {
      "Sid": "InviteQueueAccess",
      "Effect": "Allow",
      "Action": ["sqs:SendMessage", "sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"],
      "Resource": "arn:aws:sqs:ap-south-1:352801351904:saasboard-invite-queue"
    },
    {
      "Sid": "InviteTopicPublish",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:ap-south-1:352801351904:saasboard-invite-notifications"
    },
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:ap-south-1:352801351904:log-group:/ecs/saasboard-backend:*"
    }
  ]
}